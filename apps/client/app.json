{
  "expo": {
    "name": "GEONEX",
    "slug": "geonex",
    "version": "0.1.0",
    "orientation": "default",
    "icon": "./assets/images/icon.png",
    "scheme": "geonex",
    "userInterfaceStyle": "dark",
    "backgroundColor": "#0B1420",
    "description": "GEONEX — simulations géopolitiques multijoueurs.",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "app.geonex.mobile",
      "buildNumber": "1",
      "infoPlist": {
        "NSMicrophoneUsageDescription": "GEONEX utilise le micro uniquement lorsque vous avez la parole en Assemblée ou pendant une communication diplomatique que vous avez acceptée.",
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "app.geonex.mobile",
      "versionCode": 1,
      "adaptiveIcon": {
        "backgroundColor": "#FFFFFF",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "output": "single",
      "favicon": "./assets/images/favicon.png",
      "lang": "fr",
      "description": "GEONEX — simulations géopolitiques multijoueurs, gratuites et sans publicité.",
      "name": "GEONEX",
      "themeColor": "#0B1420"
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      "expo-audio",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#0B1420",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 150
        }
      ]
    ],
    "experiments": {
      "typedRoutes": false,
      "reactCompiler": true
    }
  }
}
