# Copiez ce fichier en « .env » à la racine du projet : le lanceur le lit automatiquement.
# Aucune clé n'est obligatoire pour utiliser GEONEX en local.

# --- IA : retirée ---------------------------------------------------------
# Le moteur de règles détaillé (services/engine/geonex_engine/dynamics.py) remplace l'IA.
# Le code d'IA reste dormant : il ne s'active que si GEONEX_AI=on ET qu'une clé est fournie.

# --- Recherche externe (contemporain) -------------------------------------
# Wikimedia exige un contact dans le User-Agent (adresse email ou URL de votre projet).
# Sans cette valeur, Wikipédia refuse les requêtes (403).
# GEONEX_RESEARCH_CONTACT=

# --- Voix : retirée (les participants écrivent) ----------------------------

# --- Comptes et e-mails (voir docs/PLATEFORME.md) ---------------------------
# Sans fournisseur, l'application fonctionne et indique honnêtement qu'aucun e-mail n'est envoyé.
# GEONEX_PUBLIC_URL=https://geonex.onrender.com   # adresse publique, utilisée dans les liens des e-mails
# SMTP_URL=smtp://identifiant:cle@hote:587        # ou SMTP_HOST / SMTP_PORT / SMTP_USER / SMTP_PASS / SMTP_SECURE
# GEONEX_MAIL_FROM="GEONEX <no-reply@votre-domaine>"   # expéditeur validé chez votre fournisseur (SPF, DKIM, DMARC)
# GEONEX_MAIL_REPLY_TO=contact@votre-domaine      # facultatif : où arrivent les réponses aux e-mails
# npm run mail:test -- vous@exemple.fr            # contrôle la configuration et envoie un message de test (docs/EMAILS.md)
# GEONEX_MAIL_PROVIDER=log                        # développement : écrit les e-mails dans le journal du serveur, n'envoie rien
# GEONEX_REQUIRE_VERIFIED=false                   # true : exiger l'adresse vérifiée (une fois les e-mails opérationnels)
# GEONEX_MODERATION=on                            # on : relecture par un administrateur avant publication d'un scénario

# --- Réseau et production ---------------------------------------------------
# PORT=4000
# GEONEX_ENGINE_PORT=8100
# GEONEX_OWNER_EMAILS=vous@exemple.fr        # comptes ayant le rôle propriétaire (administration)
# DATABASE_URL=postgres://user:pass@hote:5432/geonex   # PostgreSQL (sinon base embarquée locale)
# GEONEX_JWT_SECRET=                          # obligatoire en production
# GEONEX_SESSION_TTL_HOURS=48
# EXPO_PUBLIC_API_URL=https://api.exemple.fr  # uniquement si le client est hébergé séparément de l'API
